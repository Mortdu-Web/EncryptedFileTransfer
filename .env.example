# --- Développement local ---
# Port d'écoute (conteneur ET hôte)
PORT=25XXX
# Route racine de l'application, derrière le reverse proxy (mon-domaine.fr/file-transfer/)
# Vide en local ; /file-transfer en production (derrière le reverse proxy).
URL_PREFIX=
SECRET_KEY=change-me

# --- Chiffrement des fichiers (OBLIGATOIRE) ---
# Clé AES-256 en base64. Pour en générer une :
#   python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# ATTENTION : si cette clé est perdue ou changée, les fichiers déjà envoyés sont définitivement illisibles.
ENCRYPTION_KEY=
# Taille maximale d'un fichier envoyé, en Mo (le fichier est chiffré en mémoire)
MAX_UPLOAD_MB=100
# Dossier des fichiers chiffrés. En Docker c'est /data/uploads (volume) : ne pas le surcharger ici.
# En local sans Docker, valeur par défaut : instance/uploads
# UPLOAD_FOLDER=instance/uploads

# Base de données PostgreSQL (sur une autre machine)
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=
# Pool de connexions, par worker gunicorn (2 workers x 5 = 10 connexions max par defaut)
DB_POOL_MIN=1
DB_POOL_MAX=5
# true uniquement si les tables ft_* n'existent pas encore (exige le droit CREATE sur le schema public)
DB_AUTO_CREATE=false

# --- Auth (service séparé, paquet auth_client) ---
# false = pas d'authentification (dev local). true en production.
AUTH_ENABLED=false
# Auth, vu depuis le conteneur (réseau Docker "web")
AUTH_INTERNAL_URL=http://auth:25000/auth
# Auth, vu depuis le navigateur
AUTH_PUBLIC_URL=https://mon-domaine.fr/auth
# URL publique du service, route racine incluse, sans slash final
PUBLIC_URL=https://mon-domaine.fr/file-transfer
# Derrière un reverse proxy / HTTPS
BEHIND_PROXY=false
SESSION_COOKIE_SECURE=false

# --- Identité simulée quand AUTH_ENABLED=false (dev local uniquement) ---
DEV_USER_ID=dev-user
DEV_USERNAME=dev
